#!/bin/bash
# Search engine for the shell in pure bash

# cmd1 | cmd2 .. fails if any command in the pipe fails
set -o pipefail
# Enable nullglob so the array stays empty if nothing matches
shopt -s nullglob

# Main params
FILE_TYPE=""
ROOT_FOLDER=""
SEARCH_QUERY=""
META_KEY=""
META_KEY_OPTION=0
DATE_FROM_FILE=0

# Constants
INDEX_FOLDER="${HOME}/.local/state/bsearch.db"
# For storing path elements reverse index
PATH_INDEX="path.db"
# For storing hash(filepath) reverse index
HASH_INDEX="hash.db"
# For storing other metadata reverse index
META_INDEX="meta.db"
# Filename limits
FILENAME_MAX=$(getconf NAME_MAX ${HOME})

die() { printf 'bsearch: error: %s\n' "$*" >&2; exit 2; }
log() {
	local timestamp
    timestamp=$(date "+%Y-%m-%d %H:%M:%S")
	printf "[${timestamp}] $*\n" >&2
}

# Log without newline
log_non() {
	local timestamp
    timestamp=$(date "+%Y-%m-%d %H:%M:%S")
	printf "\r[${timestamp}] $*" >&2
}

# Temp file containing file paths
paths_file="$(mktemp "/tmp/.paths.XXXXXX")" || { rm -f -- "$tmp_index"; die "cannot create temporary path list"; }
cleanup() { rm -f -- "$paths_file"; }
trap cleanup EXIT

# We need one of these for PDF meta 
pdfinfo_cmd=$(command -v pdfinfo)
exiftool_cmd=$(command -v exiftool)

# Upon start
init() {
    mkdir -p ${INDEX_FOLDER} || die "error creating index folder"
    # Create sub-folders
    # We will create sub-folders for path, hash, meta
    sub_indices=(${PATH_INDEX} ${HASH_INDEX} ${META_INDEX})
    for sub_index in ${sub_indices[@]}
    do
        mkdir -p ${INDEX_FOLDER}/${sub_index}
    done
}                    

# Create index folders on init
init

usage()
{
    cat <<'EOF'
Usage:
    bsearch -t [file_ext]
    bsearch -r [root_dir]
    bsearch -s [query]
    bsearch -l [<meta_key>]
	bsearch -d
	bsearch -m


Options:

Indexing Options::
    -t EXT/MIMETYPE
                Index files with this extension/type (e.g: pdf, docx, all)  
                This can also be a mimetype like "image/jpeg", in which case all the
                matching extensions are indexed.
    -r ROOT     Directory to scan.
    -d          If enabled, picks the year up from the file name using the
                regex YYYYMMDD like IMG-20160425-WA0001.jpg or 20221005_201653.jpg
                than from image metadata. 

Search Options::
    -s QUERY    Run in search mode, searching results for "query".
                For meta queries use "field:query" format, e.g: "creator: writer"
                or "title:untitled".
    -l META_KEY List all unique keys found for the given "meta_key".
                For example "-l camera" lists unique camera models found from
                image metadata.
    -m          Prints all meta keys in the current index.
 
EOF
}

# Don't run without arguments
if [ $# -eq 0 ]; then
    usage
    exit 1
fi

# Parse arguments
while getopts 't:r:s:l:mdh' opt; do
    case $opt in
        t)
            FILE_TYPE="$OPTARG";
            if [[ ${FILE_TYPE} = "all" ]]; then
                FILE_TYPE="";
            fi
            ;;
        r)
            ROOT_FOLDER="${OPTARG}";;
        s)
            # lowercase
            SEARCH_QUERY="${OPTARG,,}";;
		l)
			# lowrcase
			META_KEY="${OPTARG,,}";
			META_KEY_OPTION=1;;
		m)
			META_KEY_OPTION=1;;
		d)
			printf "Enabling date detection from filename\n";
			DATE_FROM_FILE=1;;
        ?|h)
            usage;
            exit 1;;
    esac
done

# Commands to store data in our folder "hash store"
store_get () { local key=$1; index=$2; cat "${INDEX_FOLDER}/${index}/$key" 2>/dev/null; }
store_rm  () { local key=$1; index=$2; rm "${INDEX_FOLDER}/${index}/$key"; }

# Generic function for adding keys to kv store
store_put () {
    local key=$1; index=$2; value=$3;
    # How many keys put
    local count=0
    # Single key
    local file_path="${INDEX_FOLDER}/${index}/${key}"
    if [[ -f "$file_path" ]] && grep -Fq "$value" "$file_path"; then
        return ${count}                 
    fi
    printf "%s\n" "$value" >>"${file_path}"
    ((count+=1))        
    # fi

    return ${count}
}

# Function for adding keys to kv hash store
store_put_hash() {
    local key=$1; index=${HASH_INDEX}; value=$2;

    # The hashes are like
    # fff9b146a978ba4fed0479bd0ae1327762598a8f763bde065d8216b660b41740
    # So if we keep adding them to same folder, the inode table
    # gets overloaded and file loading becomes slow as the directory
    # grows.

    # The solution is to store them in "cache" folder format, means
    # to create directories for the first three 2 byte entries
    # and to store the entry in the remaining bytes as file.
    # So in this case the path looks like
    # ff/f9/b1/46a978ba4fed0479bd0ae1327762598a8f763bde065d8216b660b41740
    # This has the net effect of distributing files across a uniform
    # number of folders in the tree.
    dirpath="${INDEX_FOLDER}/${index}/${key:0:2}/${key:2:2}/${key:4:2}"
    mkdir -p "${dirpath}"
    # File name
    fname="${key:6}"
    fpath="${dirpath}/${fname}"
    # If file exists, we assume this is good to avoid a file write
    if [[ -f "${fpath}" ]]; then
        return 0
    else
        # Ignore ovewrites, we can avoid cost of a grep
        printf %s "$value" > "${dirpath}/${fname}"
        return 1
    fi
}

# Make entries for meta keys in the kv store
store_put_meta () {
    local key=$1; index=${META_INDEX}; sub_key=$2; value=$3;
    # How many keys put
    local count=0
    # Replace any / chars for safe key
    safe_sub_key="${sub_key//\//-}"
    local dir_path="${INDEX_FOLDER}/${index}/${key}/"
    mkdir -p "${dir_path}"

	# Add for safe subkey
    local file_path="${dir_path}/${safe_sub_key}"
    if [[ -f "$file_path" ]] && grep -Fq "$value" "$file_path"; then
        return ${count}     
    fi
    # Skip the entire subkey if the filename is too long
    if (( ${#file_path} < ${FILENAME_MAX} )); then
        printf "%s\n" "$value" >>"${file_path}"
    fi
    ((count+=1))        

    return ${count}
}

# Fuzzy get matches keys anywhere in the path
store_fuzzy_get () {
    key=$1; index=$2;
    # Do a prefix search and return the keys
    pattern="${INDEX_FOLDER}/${index}/*${key}*"
    for f in ${pattern}; do
        fpath=$(basename $f)
        if [[ -z "${fpath}" ]]; then
            continue
        fi
        # Fetch the value
        store_get "${fpath}" "${PATH_INDEX}"
    done
    
}

# Fetch values for meta key entries
store_get_meta () {
    key="$1"; index=${META_INDEX}; sub_key="$2";
    pattern="${INDEX_FOLDER}/${index}/${key}/*${sub_key}*"
    for fpath in ${pattern}; do
        if [[ ! -f ${fpath} ]]; then
            continue
        fi
        # This contains the file indices, open and read
        IFS=$'\\n' read -d '' -r -a paths < "${fpath}"
        for file_id in ${paths[@]}; do
            printf "%s\n" ${file_id}
        done
    done
}

# Fetch values for hash key entries
store_get_hash () {
    local key=$1; index=${HASH_INDEX};
    dirpath="${INDEX_FOLDER}/${index}/${key:0:2}/${key:2:2}/${key:4:2}" 
    fname="${key:6}"    
    fpath="${dirpath}/${fname}"
    if [[ -f "${fpath}" ]]; then
        cat "${fpath}" 2>/dev/null;
    fi
}

start_message() {
	
    if [[ -n "${SEARCH_QUERY}" ]]; then
        log "Running in search mode with query \"${SEARCH_QUERY}\"" 
    elif [[ -n ${FILE_TYPE} ]]; then
        log "Running in indexing mode - invoked on \"${ROOT_FOLDER}\" with filetype ${FILE_TYPE}"
    elif [[ ${META_KEY_OPTION} -eq 1 ]]; then
		printf ""
		# Don't print any mode
	else
        log "Running in indexing mode - Invoked on \"${ROOT_FOLDER}\"" 
    fi
}

# Split a file path into chunks 
split_path() {
    local IFS='/'
    read -ra chunks <<< "$1"
    # Filter empty elements
    for chunk in "${chunks[@]}"; do
        [[ -n "$chunk" ]] && echo "$chunk"
    done
}

perform_meta_search() {
	# Split by AND if any
	local query="${SEARCH_QUERY,,}"
	local delim=" and "
	
    if [[ "${query}" =~ "${delim}" ]]; then
		# Replace any " and " occurrences with spaces
		query="${query//${delim}/ }"
	fi
	# Split by spaces
	local search_terms=($query)
	# Match any ext:<value> term
	local ext_term=""
	for index in "${!search_terms[@]}"; do
		local term="${search_terms[index]}"
		if [[ "${term}" =~ ^"ext" ]]; then
			# Drop such terms and match them at end
			# Only pick the very first term like this
			ext_term="${term#*:}"			
			unset "search_terms[$index]"
			# Re-index the array
			search_terms=("${search_terms[@]}")
			break
		fi
		((index++))
	done

	# If ext term and it doesn't start with ".", add a "."
	if [[ -n "${ext_term}" ]] && [[ ! "${ext_term}" =~ ^"." ]]; then
		ext_term=".${ext_term}"
	fi

	local term_count=${#search_terms[@]}
	
	# If there is only one search term
	if [[ ${term_count} -eq 1 ]]; then
		local term=${search_terms[0]}
		local hits=($(perform_search "${term}"))
		list_hits "${ext_term}" "${hits[@]}" 
	else
		local search_hits=()
		# First make hits from first term
		local term1="${search_terms[0]}"
		local hits=($(perform_search "${term1}"))
		# dedup it
		local hits_dedup=($(dedup_array "${hits[@]}"))
		# Now get hits for other terms and find
		# common items
		for term in "${search_terms[@]}"; do
			# Perform search for each
			local hits_new=($(perform_search "${term}"))
			# Dedup it
			local hits_dedup_new=($(dedup_array "${hits_new[@]}"))
			# Now find common items between first and this
			mapfile -t hits_common < <(
				cat <(printf '%s\n' "${hits_dedup[@]}" | sort -u) \
					<(printf '%s\n' "${hits_dedup_new[@]}" | sort -u) | sort | uniq -d
			)
			# Reassign to hits_dedup1
			hits_dedup=("${hits_common[@]}")
		done

		list_hits "${ext_term}" "${hits_dedup[@]}"
	fi
}

# List meta keys
list_meta_keys() {

	meta_index_path="${INDEX_FOLDER}/${META_INDEX}/"
	# This can take 2 paths, one listing meta keys
	# or listing unique keys for given meta key
	if [[ -z "${META_KEY}" ]]; then
		# List all meta keys
		meta_path="${meta_index_path}"
	else
		# Each meta key should be a folder
		# inside META_INDEX folder.
		meta_path="${INDEX_FOLDER}/${META_INDEX}/${META_KEY}"
		if [[ ! -d "${meta_path}" ]]; then
			die "no metadata found matching key '${META_KEY}'" 
		fi
	fi

	# List the values
	files=( ${meta_path}/* )
	count="${#files[@]}"
	index=0
	if [[ -z "${META_KEY}" ]]; then	
		log "${count} unique meta keys found in the index.\n"
	else
		log "Found ${count} unique keys for '${META_KEY}'\n"
	fi
	
	for fpath in "${files[@]}"; do
		((index++))
		f=$(basename "${fpath}")
		printf "${index}. ${f}\n"
	done
}

dedup_array() {
	declare -A unique_map

	local items=("$@")
    for item in ${items[@]}
    do
		if [[ -z "${item}" ]]; then
			continue
		fi
        unique_map[$item]=1
    done	

	items_dedup=("${!unique_map[@]}")	
	echo "${items_dedup[@]}"
}

# List the search hits
list_hits() {
    # Reconstruct into array
	local ext_term="$1"
	shift
    local hits=("$@")
    local count=0

    # Remove dups
    declare -A unique_map
    local hit_count=0

	hit_count=${#hits[@]}
	
	if [[ ${hit_count} -gt 0 ]]; then
		printf "\n" >&2
	
		# Extract back into regular array
		hits_dedup=($(dedup_array "${hits[@]}"))	
		for hit in "${hits_dedup[@]}"; do
			fpath=$(store_get_hash ${hit})
			if [[ -z "${fpath}" ]]; then
				continue
			fi
			
			# If ext term is specified make sure the extension matches
			if [[ -z "${ext_term}" ]]; then
				printf "\"%s\"\n" "${fpath}"
				((count++))				
			elif [[ "${fpath}" =~ "${ext_term}"$ ]]; then
				printf "\"%s\"\n" "${fpath}"				
				((count++))
			fi
		done
		printf "\n" >&2
	fi

	log "Found ${count} hits for query \"${SEARCH_QUERY}\"\n"	
}

# Extract year from timestamp
extract_year() {
	local timestamp="$1";
	local fpath="$2";
	local valid=0
	local year=0
	
	# Year now
	local toyear=$(date +%Y)
	# If DATE_FROM_FILE is enabled try to fetch
	# date stamp from the filename
	if [[ $DATE_FROM_FILE -eq 1 ]]; then
		local fname=$(basename "${fpath}")
		# Look for strings like 20160425
		local datestamp=$(echo "${fname}" | grep -oE '[0-9]{8}')
		# Now do some basic checks
		if [[ -n "${datestamp}" ]]; then
			year=${datestamp:0:4}
			local month=${datestamp:4:2}
			local day=${datestamp:6:2}
			# Make sure to convert these to decimal
			# in case of leading zeros
			month=$((10#$month))
			day=$((10#$day))			
			# Check some ranges
			[[ $year -ge 1970 ]] && [[ $year -le $toyear ]] && \
				[[ $month -ge 1 ]] && [[ $month -le 12 ]] && \
				[[ $day -ge 1 ]] && [[ $day -le 31 ]] && valid=1
			if [[ $valid -eq 1 ]]; then
				echo "${year}"
			fi
		fi
	fi
	if [[ $valid -eq 0 ]]; then
		year=$(echo "${timestamp}" | grep -oE '^[0-9]{4}')
		if [[ -n "${year}" ]]; then
			echo "${year}"
		fi
	fi
}

# Generic function to extract metadata given metadata string
# and interested keys
extract_metadata() {
	local fpath="$1"
    shift	
    local metadata="$1"
    shift
    local meta_keys=("$@")
    local total=0
    
    while IFS='|' read -r key value; do
        # lowercase
        key="${key,,}"
        value="${value,,}"
        # trim leading spaces
        key="${key#"${key%%[![:space:]]*}"}"        
        value="${value#"${value%%[![:space:]]*}"}"
        # trim trailing spaces      
        value="${value%"${value##*[![:space:]]}"}"
        key="${key%"${key##*[![:space:]]}"}"        
        # If value is empty skip
        if [[ -z "${value}" ]]; then
            continue
        fi
        # echo "Looking at ${key}"                  
        for meta_key in "${meta_keys[@]}"; do
            # echo "Comparing \"${key}\" with \"${meta_key}\""
            # Keys of our interest
            if [[ "${meta_key}" == "${key}" ]]; then
                # echo "Key match: ${key}"          
                # Store it with a proper prefix
                # key substitutions - pdfs
				case "${key}" in
					"pdf version")
						key="version"
						;;
					"encrypted")
						# For encrypted we only need the yes or no
						# ignore anything in (...) after it
						value="${value%%(*}"
						;;
					"camera model name")
						key="camera"
						;;
					"file source")
						key="source"
						;;
					"image size")
						key="resolution"
						;;
					"creationdate"|"create date"|"file modification date/time")
						key="year";
						value=$(extract_year "${value}" "${fpath}");
						;;
					geolocation\ *)
						key="${key#geolocation }"
						;;
				esac
                # echo "Store putting ${key} ${value} ${file_id}"
                store_put_meta "${key}" "${value}" "${file_id}"
                local ret=$?
                ((total+=ret))
            fi
        done
	# Using this logic has a bug -- if values contain ":" like timestamps
    # done < <(printf "%s" "${metadata}" | awk -F ':' 'NF>=2{print $1 "|" $2}')
	done < <(
		# This logic fixes it
		printf "%s" "${metadata}" |
			awk 'index($0, ":") { key = $0; sub(/:.*/, "", key); value = $0; sub(/^[^:]*:/, "", value); print key "|" value }'
	)
	
    return ${total}
}

# Extract and index metadata of raster images using exiftool
extract_metaimage() {
    local fpath="$1"
    local file_id="$2"
    local metadata=""

    # If exiftool doesn't exist, give up
    if [[ -z ${exiftool_cmd} ]]; then
        return 0
    fi

    metadata=$(${exiftool_cmd} "${fpath}")
    if [[ -z "${metadata}" ]]; then
        return 0
    fi

    # echo "Extracting meta image for ${fpath}"
    # Fetch all metadata of interest
    local meta_keys=("make" "camera model name" "image size" "orientation" "file source" "software" "create date" "file modification date/time")
    extract_metadata "${fpath}" "${metadata}" "${meta_keys[@]}"
    local total=$?

	# GPS zero data pattern
	zero_pattern="GPS (Latitude|Longitude)[[:space:]]*:[[:space:]]*0 deg 0' 0\.00\""
	# Fetch GPS data and build GPS keys if available, ignore zero GPS data
	if [[ "${metadata}" == *"GPS"* ]] && [[ ! "${metadata}" =~ ${zero_pattern} ]]; then
		# Run exiftool again and capture GPS details
		gps_metadata=$(${exiftool_cmd} -api geolocation "-geolocation*" "${fpath}" 2>/dev/null)
		local gps_meta_keys=("geolocation city" "geolocation region" "geolocation subregion" "geolocation country")
		extract_metadata "${fpath}" "${gps_metadata}" "${gps_meta_keys[@]}"
		((total++))
	fi
	
    return ${total}
}

# Extract and index metadata of PDF files using {pdfinfo,exiftool}
extract_metapdf() {
    local fpath="$1"
    local file_id="$2"
    local metadata=""

    # If tools don't exist, give up
    if [[ -z ${pdfinfo_cmd} && -z ${exiftool_cmd} ]]; then
        return 0
    fi
    
    if [[ -n ${pdfinfo_cmd} ]]; then
        metadata=$(${pdfinfo_cmd} "${fpath}" 2>/dev/null)
    elif [[ -n ${exiftool_cmd} ]]; then 
        metadata=$(${exiftool_cmd} "${fpath}" 2>/dev/null)
    fi

    if [[ -z "${metadata}" ]]; then
        return 0
    fi

    # These are our keys of interest
	# creationdate: pdfinfo
	# create date: exiftool
    local meta_keys=("creator" "creationdate" "create date" "producer" "pdf version" "tagged" "title" "encrypted") 
    extract_metadata "${fpath}" "${metadata}" "${meta_keys[@]}"
    local total=$?
    
    return ${total}
}

perform_search() {
	query="$1"
    # Meta search if there is : in the string
    if [[ "${query}" == *":"* ]]; then
        # Split to left of :
        key="${query%%:*}"
        # Split to right of :
        value="${query#*:}"
        log "Performing meta search using key=${key} and value=${value}"
        matches=$(store_get_meta "${key}" "${value}")
    else
        # Try exact match
        printf "\n"
		# Fuzzy match only as it gets exact matches also
        matches=$(store_fuzzy_get "${query}" "${PATH_INDEX}")
    fi
    # Split by array
    IFS=$'\\n' read -d '' -r -a hits <<< "$matches"
    # list_hits "${hits[@]}"
    printf "${hits[@]}"
}

# Build a list of files to index
# Optionally accepts file types as extensions
: > "$paths_file"
build_flist() {
    local extn="$1"
    shift
    local root="$1"
    local count=0
    
    # If mime-type is given
    extn=${extn,,}
    if [[ "$extn" =~ ^[[a-z0-9]+/[a-z0-9]+$ ]];
       then
           log "Mimetype given, fetching extensions for ${extn}"
           extns=$(awk -v e="${extn}" '$1 == e { $1=""; print }' /etc/mime.types)
           if [[ -z "${extns}" ]]; then
               die "no extenions found for mimetype ${extn}!"
           fi
       fi
        
    log "Building list of files..."
    if [[ -n "${extns}" ]]; then
        # Convert to array
        extns=( $extns )
        # Build using multiple extensions
        find_args=()
        if [ ${#extns[@]} -gt 0 ]; then
            find_args+=( -name "*.${extns[0]}" )
        fi
        for ((i=1; i<${#extns[@]}; i++)); do
            find_args+=( -o -name "*.${extns[i]}" )
        done
        find "$root" -name ".*" -prune -o \( -type f -o -type l \) ! -name '.*' \( "${find_args[@]}" \) -print0
    elif [[ -n "$extn" ]]; then
        find "$root" -name ".*" -prune -o \( -type f -o -type l \) ! -name '.*' -name "*.${extn}" -print0
    else
        find "$root" -name ".*" -prune -o \( -type f -o -type l \) ! -name '.*' -print0
    fi  |
        while IFS= read -r -d '' fpath; do
            printf '%s\n' "$fpath" >> "$paths_file"
            ((count++))
            log_non "Processed #${count} files."
        done
}       

# Buld the indices for files
index_files() {
	
    local total=0; index_total=0; index_meta=0; index_hash=0; index_path=0;
    local current_path="";

	printf "\n"
    log "Creating indices..."
    while IFS= read -r current_path;
    do
        # Trim newline if any
        current_path="${current_path%$'\n'}"
        # Construct hash of the path as a unique file id
        local file_id="$(printf '%s' "$current_path" | sha256sum)"
        file_id="${file_id%% *}"
        # Save this in the hash index
        store_put_hash "$file_id" "${current_path}"
        local ret_hash=$?
        ((index_total+=$ret_hash))
        ((index_hash+=$ret_hash))               
        # Read into an path array
        mapfile -t path_array < <(split_path "$current_path")

        # For each entry in path, store it as a reverse index
        for path in ${path_array[@]}; do
            # Lowercase
            local path_l=${path,,}
            # This goes to the path index
            store_put "$path_l" ${PATH_INDEX} "$file_id"
            local ret_path=$?
            ((index_total+=ret_path))
            ((index_path+=ret_path))                            
        done

        # Extract metadata entries for PDF/images
        path_l="${current_path,,}"
		# printf "Current: ${current_path}\n"
	   
        if [[ "${path_l}" == *.pdf ]]; then
            extract_metapdf "${current_path}" ${file_id}
            local ret_meta=$?
            # Update counts
            ((index_meta+=ret_meta))
            ((index_total+=ret_meta))
        # Images
        elif [[ "${path_l}" =~ \.(jpg|jpeg|png|gif|webp|bmp|tiff)$ ]]; then
            extract_metaimage "${current_path}" ${file_id}
            local ret_meta=$?
            # Update counts
            ((index_meta+=ret_meta))
            ((index_total+=ret_meta))                   
        fi
        ((total+=1))
        log_non "Indexed #${total} files..."
    done < "$paths_file"
    printf "\n" >&2
	log "Created ${index_hash} hash index entries." 
    log "Created ${index_path} path index entries."
    log "Created ${index_meta} meta index entries."
    log "Created ${index_total} total index entries."
}

# Performs the file indexing
perform_index() {
    # First build file list
    # Get full path to folder
    ROOT_FOLDER=$(realpath "${ROOT_FOLDER}")
    build_flist "${FILE_TYPE}" "${ROOT_FOLDER}"
    # If we didn't detect any file, there is nothing to do
    local line_count=$(wc -l < "$paths_file")
    if [[ ${line_count} -eq 0 ]];
    then
        die "no files were found, goodbye."
    fi
    # printf "\n$paths_file"
    index_files
}

# Main body
start_message

if [[ ${META_KEY_OPTION} -eq 1 ]]; then
	list_meta_keys
elif [[ -n "${SEARCH_QUERY}" ]]; then
    perform_meta_search
elif [[ -n "${ROOT_FOLDER}" ]]; then
    perform_index
